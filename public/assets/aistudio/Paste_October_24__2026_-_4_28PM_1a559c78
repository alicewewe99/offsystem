    <script>
        // Web Audio API 8-Bit 蘑菇王國聲效合成器
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) audioCtx = new AudioCtx();
            if (audioCtx.state === 'suspended') audioCtx.resume();
        }

        document.addEventListener('touchstart', initAudio, { once: true });
        document.addEventListener('click', initAudio, { once: true });

        function playSound(type) {
            try {
                initAudio();
                if (!audioCtx) return;
                const now = audioCtx.currentTime;

                if (type === 'powerup') {
                    // 吃超級蘑菇變大音效
                    const freqs = [330, 392, 659, 523, 587, 784];
                    freqs.forEach((f, i) => {
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'square';
                        osc.frequency.setValueAtTime(f, now + i * 0.05);
                        gain.gain.setValueAtTime(0.1, now + i * 0.05);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + i * 0.05 + 0.08);
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start(now + i * 0.05);
                        osc.stop(now + i * 0.05 + 0.08);
                    });
                } else if (type === 'toadJump') {
                    // 奇諾比奧可愛跳躍聲
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(260, now);
                    osc.frequency.exponentialRampToValueAtTime(880, now + 0.12);
                    gain.gain.setValueAtTime(0.18, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now);
                    osc.stop(now + 0.15);
                } else if (type === 'win') {
                    // 蘑菇王國勝利音階
                    const notes = [523.25, 659.25, 783.99, 1046.50, 880, 1046.50];
                    notes.forEach((freq, idx) => {
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'square';
                        osc.frequency.setValueAtTime(freq, now + idx * 0.07);
                        gain.gain.setValueAtTime(0.12, now + idx * 0.07);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + idx * 0.07 + 0.09);
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start(now + idx * 0.07);
                        osc.stop(now + idx * 0.07 + 0.09);
                    });
                } else if (type === 'pop') {
                    // 輕微按鍵音
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(500, now);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.04);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now);
                    osc.stop(now + 0.04);
                } else if (type === 'error') {
                    // 毒蘑菇撞擊/警告音效
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(150, now);
                    osc.frequency.setValueAtTime(90, now + 0.1);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.2);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now);
                    osc.stop(now + 0.2);
                }
            } catch (e) {
                console.log("Audio play error:", e);
            }
        }

        let selectedDates = [];
        const weekdays = ["日", "一", "二", "三", "四", "五", "六"];

        function getFormattedDate(offsetDays = 0) {
            const target = new Date();
            target.setDate(target.getDate() + offsetDays);
            const y = target.getFullYear();
            const m = String(target.getMonth() + 1).padStart(2, '0');
            const d = String(target.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function setTodayDate() {
            document.getElementById('dateInput').value = getFormattedDate(0);
        }

        function setQuickDate(offset) {
            playSound('pop');
            const targetStr = getFormattedDate(offset);
            document.getElementById('dateInput').value = targetStr;
            addDate();
        }

        window.onload = function() {
            setTodayDate();
            updateLivePreview();
        };

        function formatDateDisplay(dateStr) {
            if (!dateStr) return '';
            const parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;
            const d = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
            return `${d.getMonth() + 1}/${d.getDate()}（${weekdays[d.getDay()]}）`;
        }

        function addDate() {
            const dateVal = document.getElementById('dateInput').value;
            if (!dateVal) return;
            if (selectedDates.includes(dateVal)) {
                playSound('error');
                showAlert("這個日期已經加過了唷！🍄");
                return;
            }
            selectedDates.push(dateVal);
            selectedDates.sort(); 
            renderDates();
            updateLivePreview();
        }

        function removeDate(date) {
            playSound('pop');
            selectedDates = selectedDates.filter(d => d !== date);
            renderDates();
            updateLivePreview();
        }

        function renderDates() {
            const list = document.getElementById('dateList');
            list.innerHTML = '';
            if (selectedDates.length === 0) {
                list.innerHTML = '<span id="noDateHint" class="text-gray-400 p-2 font-bold">🍄 尚未加入請假日期喔！</span>';
                return;
            }
            selectedDates.forEach(date => {
                const span = document.createElement('span');
                span.className = 'mushroom-tag';
                span.innerHTML = `${formatDateDisplay(date)} <button onclick="removeDate('${date}')" class="ml-2 text-red-600 font-black hover:text-red-800 focus:outline-none">×</button>`;
                list.appendChild(span);
            });
        }

        function toggleOtherInput(type) {
            const select = document.getElementById(type);
            const container = document.getElementById(`other${type.charAt(0).toUpperCase() + type.slice(1)}Container`);
            container.classList.toggle('hidden', select.value !== '自填');
        }

        function updateLivePreview() {
            const name = document.getElementById('name').value.trim();
            const attendance = document.getElementById('attendance').value;
            const transport = document.getElementById('transport').value;
            const reason = document.getElementById('reason').value;
            const food = document.getElementById('food').value;
            const note = document.getElementById('customNote').value.trim();

            const attendanceName = document.getElementById('attendanceName').value.trim();
            const transportName = document.getElementById('transportName').value.trim();
            const reasonName = document.getElementById('reasonName').value.trim();
            const foodName = document.getElementById('foodName').value.trim();
            const noteName = document.getElementById('noteName').value.trim();

            const finalAttendance = attendance === '自填' ? document.getElementById('otherAttendance').value.trim() : attendance;
            const finalTransport = transport === '自填' ? document.getElementById('otherTransport').value.trim() : transport;
            const finalReason = reason === '自填' ? document.getElementById('otherReason').value.trim() : reason;
            const finalFood = food === '自填' ? document.getElementById('otherFood').value.trim() : food;

            const formattedDates = selectedDates.length > 0 
                ? selectedDates.map(d => formatDateDisplay(d)).join('、') 
                : "尚未選擇日期";
            
            let preview = `【長輩請假通知 🍄 ✨ 🌟】\n\n📅 日期：${formattedDates}`;
            
            if (name) {
                preview += `\n👤 個案：${name}`;
            }
            
            if (finalAttendance) {
                preview += `\n🏫 出席：${finalAttendance}`;
                if (attendanceName) preview += `（${attendanceName}）`;
            }
            if (finalTransport) {
                preview += `\n🚐 交通車：${finalTransport}`;
                if (transportName) preview += `（${transportName}）`;
            }
            if (finalReason) {
                preview += `\n📝 原因：${finalReason}`;
                if (reasonName) preview += `（${reasonName}）`;
            }
            if (finalFood) {
                preview += `\n🍱 伙食：${finalFood}`;
                if (foodName) preview += `（${foodName}）`;
            }
            if (note) {
                preview += `\n📌 備註：${note}`;
                if (noteName) preview += `（${noteName}）`;
            }
            
            document.getElementById('livePreview').innerText = preview;
        }

        function generateMessage() {
            const attendance = document.getElementById('attendance').value;
            const transport = document.getElementById('transport').value;
            const reason = document.getElementById('reason').value;
            const food = document.getElementById('food').value;

            if (selectedDates.length === 0) { 
                playSound('error');
                showAlert("別忘了先選日期並點「加入」喔！🪙"); 
                return; 
            }

            if (attendance === '自填' && !document.getElementById('otherAttendance').value.trim()) { playSound('error'); showAlert("請寫下自訂的出席情形！🏫"); return; }
            if (transport === '自填' && !document.getElementById('otherTransport').value.trim()) { playSound('error'); showAlert("請寫下自訂的交通需求！🚐"); return; }
            if (reason === '自填' && !document.getElementById('otherReason').value.trim()) { playSound('error'); showAlert("請寫下自訂的請假原因！📝"); return; }
            if (food === '自填' && !document.getElementById('otherFood').value.trim()) { playSound('error'); showAlert("請寫下自訂的伙食需求！🍱"); return; }

            playSound('win');
            const finalMessage = document.getElementById('livePreview').innerText;
            
            document.getElementById('messageBox').innerText = finalMessage;
            document.getElementById('resultModal').classList.remove('hidden');
        }

        function closeModal() { 
            document.getElementById('resultModal').classList.add('hidden'); 
        }

        async function shareToApp() {
            const text = document.getElementById('messageBox').innerText;
            if (navigator.share) {
                try { 
                    await navigator.share({ text: text }); 
                } catch (err) {}
            } else {
                copyToClipboard(text);
                showNotice("已為您複製文字囉！🌟");
            }
        }

        function copyAndClose() {
            copyToClipboard(document.getElementById('messageBox').innerText);
            showNotice("文字複製成功！👑");
            setTimeout(closeModal, 1200);
        }

        function copyToClipboard(text) {
            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.opacity = "0";
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
        }

        function showNotice(msg) {
            const notice = document.getElementById('copyNotice');
            notice.innerText = msg;
            notice.classList.remove('hidden');
            setTimeout(() => notice.classList.add('hidden'), 1500);
        }

        function showAlert(msg) {
            const div = document.createElement('div');
            div.className = "fixed top-10 left-1/2 -translate-x-1/2 toad-red text-white px-6 py-4 rounded-2xl text-lg md:text-xl z-50 shadow-2xl font-black text-center w-72 retro-border border-black";
            div.innerText = msg;
            document.body.appendChild(div);
            setTimeout(() => div.remove(), 2500);
        }
    </script>
</body>
</html>